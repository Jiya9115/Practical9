<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PlacementHub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="brand" asp-controller="Placement" asp-action="Index">Placement<span>Hub</span></a>
            <a class="btn btn-light btn-sm fw-semibold" asp-controller="Placement" asp-action="Index">Dashboard</a>
        </div>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="foot">Placement Dashboard &bull; ASP.NET Core MVC &bull; ADO.NET</footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
